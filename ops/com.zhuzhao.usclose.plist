<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zhuzhao.usclose</string>

  <!-- 周一~五 14:00（本机本地时区 America/Los_Angeles）＝ 美东 17:00
       ＝ 美股收盘(16:00 ET)后 1 小时，留出 Yahoo/yfinance 数据 settle 的余量。
       ET 与 PT 同步换夏令时，故本地墙钟对收盘的相对位置全年稳定，无需按季调整。

       与日更主班 com.zhuzhao.marketdata (02:30 本地) 的关系：
         主班 02:30 PT ＝ 05:30 ET，排在**当日美股开盘前**，所以它取到的美股腿
         天然是隔夜/盘中读数 —— us_anchor_daily 结构性晚一天正源于此。
         本班排在收盘后，专门消除这一天滞后。两班顺序：本班 D 14:00 → 主班 D+1 02:30。

       跑早了会怎样：取数脚本自带盘中守卫，会丢弃盘中快照 → 本班少写一天，
       下一班按 max+1 为起点自愈。宁可少一天，不可假一天。
       没跑成会怎样（合上盖/关机）：launchd 会在唤醒后补触发；即便整天漏掉，
       下一班同样按 max+1 把缺口一次补齐。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- 顶层程序＝python3.13(已授 FDA)，令整条链在授权解释器下跑，不必给 /bin/bash 开权限。
       与主班同款理由，勿改成 /bin/bash 跑 .sh。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3.13</string>
    <string>/Users/lunarabbit/Documents/Claude/Projects/Financial/烛照九阴/ops/mac_us_close_backfill.py</string>
  </array>

  <!-- launchd 环境极简，显式给 HOME 与 PATH -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/lunarabbit</string>
    <key>PATH</key>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- 装载时不自动跑，靠日历触发 + 手动 kickstart 验证 -->
  <key>RunAtLoad</key>
  <false/>

  <!-- ⚠️ stdio 路径必须落在 TCC 保护区之外（2026-09-18 迁 · GOTCHA `剑酒青丘/GOTCHAS.md` NOTE-20260918-001）：
       旧址在 ~/Documents（TCC 区）内，launchd 在 spawn 前**自己**去 open 这两个文件，被 TCC/macl 拒
       → 进程根本没被创建 → 零 stdout 零 stderr、只留 `last exit code = 78: EX_CONFIG`，静默停摆。
       本班 2026-09-17 14:00 那次排期即因此未点火（`ops/.last_run_status_usclose` 停在 09-16 14:00）；
       09-18 改名留档让 launchd 重建后，当日 14:00 恢复跑通（stdout 1696B · 无 ❌）。
       治本＝迁出保护区：~/Library/Logs 不在 TCC 保护面内，且是系统既有目录（launchd 不会替我们建目录）。
       注意：bootout/bootstrap 单独治不好这个病，计数器归零不等于修复。
       脚本自身另有带日期的日志 logs/mac_usclose_*.log（脚本自管，不受此约束）。 -->
  <key>StandardOutPath</key>
  <string>/Users/lunarabbit/Library/Logs/com.zhuzhao.usclose-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lunarabbit/Library/Logs/com.zhuzhao.usclose-stderr.log</string>
</dict>
</plist>
